POSTGRES_USER=traffic
POSTGRES_PASSWORD=changeme
POSTGRES_DB=traffic_replay

# Scheduler web UI login (basic auth)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Cloudflare Tunnel exposing the scheduler UI (point its public hostname at http://scheduler:8080)
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token

# R2 upload (optional - collator skips upload if not set)
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
